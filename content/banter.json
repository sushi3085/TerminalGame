  },
  {
    "id": "smallTalk",
    "once": false,
    "script": "banterSmallTalk"
  },
  {
    "id": "forestTalk",
    "once": false,
    "at": [
      "woodsEdge",
      "woodsPath",
      "woodsClearing",
      "woodsDeep"
    ],
    "script": "banterForestTalk"
  },
  {
    "id": "balTalk",
    "once": false,
    "if": "party:bal",
    "script": "banterBalTalk"
  }
]
